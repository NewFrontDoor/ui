{
  "name": "@newfrontdoor/audio-player",
  "version": "0.3.2",
  "description": "An audio element wrapper written in React with hooks",
  "license": "MIT",
  "author": "Alan Reader",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "source": "index.ts",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --format cjs --deps.skip-node-modules-bundle --clean",
    "watch": "tsdown src/index.ts --format esm --format cjs --deps.skip-node-modules-bundle --watch"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "audio",
    "wrapper",
    "hooks"
  ],
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.2.0",
    "theme-ui": "^0.17.4"
  },
  "dependencies": {
    "react-icons": "^5.6.0",
    "react-range": "^1.8.6"
  },
  
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  }
}
