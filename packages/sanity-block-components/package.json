{
  "name": "@newfrontdoor/sanity-block-components",
  "version": "0.1.1",
  "description": "A collection of components for rendering custom blocks from Sanity portable text",
  "license": "MIT",
  "author": "Alan Reader",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsdown src/index.js --format esm --format cjs --deps.skip-node-modules-bundle --clean",
    "watch": "tsdown src/index.js --format esm --format cjs --deps.skip-node-modules-bundle --watch"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "sanity",
    "portable",
    "text"
  ],
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/react": "^3.1.1",
    "react": "^19.2.0",
    "theme-ui": "^0.17.4"
  },
  
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "module": "dist/index.mjs"
}
