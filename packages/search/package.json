{
  "name": "@newfrontdoor/search",
  "version": "0.4.0",
  "description": "An collection of search components",
  "keywords": [
    "react",
    "search",
    "collection",
    "filter"
  ],
  "author": "Alan Reader",
  "license": "MIT",
  "source": "src/index.js",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "scripts": {
    "build": "tsdown src/index.js --format esm --format cjs --deps.skip-node-modules-bundle --clean",
    "watch": "tsdown src/index.js --format esm --format cjs --deps.skip-node-modules-bundle --watch"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "use-debounce": "^3.4.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.2.0",
    "theme-ui": "^0.17.4"
  },
  
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  }
}
